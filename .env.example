# === Telegram ===
BOT_TOKEN=123456789:AAExampleTelegramBotTokenGoesHere
# Telegram ID yoki chat_id (guruh/kanal uchun manfiy son bo'lishi mumkin) — HR bildirishnomalari shu yerga yuboriladi
HR_NOTIFY_CHAT_ID=-1001234567890

# Bootstrap uchun: asosiy (.env) super_admin — bu hisobni boshqa superadminlar o'zgartira yoki
# o'chira olmaydi, lekin bu superadmin boshqa superadminlarni qo'sha/o'chira oladi.
# Bo'sh bo'lsa hech kim admin bo'lmaydi, keyin qo'lda DB ga qo'shiladi.
BOOTSTRAP_SUPER_ADMIN_ID=123456789
BOOTSTRAP_SUPER_ADMIN_PHONE=+998901234567
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-strong-password

# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lazana_hr
POSTGRES_USER=lazana
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://lazana:change-me-strong-password@localhost:5432/lazana_hr

# === Redis (FSM storage + rate limiting) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# === Xavfsizlik / Web admin panel ===
# JWT imzolash uchun tasodifiy uzun satr (masalan: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_JWT_SECRET=change-me-to-a-random-64-char-hex-string
ADMIN_JWT_EXPIRE_MINUTES=480

# === Cheklovlar ===
RATE_LIMIT_PER_MINUTE=20
REAPPLY_COOLDOWN_HOURS=24
MIN_AGE_YEARS=16
MAX_AGE_YEARS=70

# === Monitoring (ixtiyoriy) ===
SENTRY_DSN=

# === Muhit ===
ENVIRONMENT=production
LOG_LEVEL=INFO
